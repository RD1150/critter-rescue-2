# Copy this file to .env.native on the release machine. Do not commit .env.native.
# Both values must use HTTPS and point to the reviewed production origin that
# serves the deployed Critter Rescue application and durable /manus-storage media.
VITE_NATIVE_APP_ORIGIN=https://crittergame-jtesdgpd.manus.space

# Native beta feedback posts to this reviewed production endpoint. Leave the
# feature disabled in a release build until a real parental gate is in place.
VITE_NATIVE_ENABLE_PARENT_FEEDBACK=false
