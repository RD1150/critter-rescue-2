# Required database connection
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/visionroute

# OAuth/session values are injected by the managed platform or configured by another host
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_JWT_SECRET=

# Managed AI (server only)
MANUS_API_URL=
MANUS_API_KEY=
VISIONROUTE_AI_MODEL=gpt-5-mini
VISIONROUTE_AI_MODEL_ROUTE=
VISIONROUTE_AI_MODEL_CHECKIN=
VISIONROUTE_AI_MODEL_REROUTE=
VISIONROUTE_AI_MODEL_BRIEF=

# Stripe test mode (server only except publishable key)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional transactional email provider configuration
RESEND_API_KEY=
EMAIL_FROM=

# Server port
PORT=3000
